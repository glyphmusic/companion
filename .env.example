# Copy to .env and fill in. .env is ignored by git.

# At least 32 random characters, identical to the Worker secret
# YTDLP_SERVICE_TOKEN (wrangler secret put YTDLP_SERVICE_TOKEN).
YTDLP_SERVICE_TOKEN=

# Token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel).
TUNNEL_TOKEN=
