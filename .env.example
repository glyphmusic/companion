# Copy to .env and fill in. .env is ignored by git.

# At least 32 random characters, identical to the Worker secret
# YTDLP_SERVICE_TOKEN (wrangler secret put YTDLP_SERVICE_TOKEN).
YTDLP_SERVICE_TOKEN=

# A second, different secret for status and updates through the Worker,
# identical to the Worker secret COMPANION_ADMIN_TOKEN. Empty = off.
COMPANION_ADMIN_TOKEN=

# 1 once your Worker signs its requests (server changelog: "signed companion requests").
GLYPH_COMPANION_SIGNED_ONLY=0

# Token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel).
TUNNEL_TOKEN=
